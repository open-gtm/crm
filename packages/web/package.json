  "description": "The hl-crm-db web UI: a generic, metadata-driven reference app served by the API from the same origin",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "E2E_SCREENSHOTS=1 playwright test --project=chromium",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@hl-crm-db/sdk": "workspace:*",
