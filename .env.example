# Copy of the variables `sh scripts/init-env.sh` generates into .env. Prefer running that script:
# it fills these with random values. The values below are intentionally empty: Docker Compose and
# the app refuse to start until you set real secrets (placeholders like change-me are rejected).
POSTGRES_PASSWORD=
HLCRM_MIGRATOR_PASSWORD=
HLCRM_APP_PASSWORD=
# 32 random bytes, base64: `openssl rand -base64 32`. Wraps each workspace's data key.
# Back it up separately from the database: losing it makes restricted fields unreadable.
HLCRM_MASTER_KEY=

# Optional
# Image release to run (default: latest), e.g. 0.2.0
# HLCRM_VERSION=
# Email for alerts and digests. STARTTLS required on 587, or smtps:// on 465. Unset turns email off.
# SMTP_URL=smtp://user:pass@host:587
# SMTP_FROM=Acme CRM <alerts@acme.com>
# Let webhooks reach http:// URLs and private addresses (cloud metadata stays blocked). Default false.
# WEBHOOK_ALLOW_INSECURE_TARGETS=false
# Automations: per-workspace hourly caps on action steps, HTTP requests and emails, emails per automation
# per hour, and emails one address may get from a workspace's automations in a day (docs/automations.md).
# AUTOMATION_ACTIONS_PER_HOUR=5000
# AUTOMATION_HTTP_PER_HOUR=500
# AUTOMATION_EMAILS_PER_HOUR=200
# AUTOMATION_EMAILS_PER_AUTOMATION_HOUR=50
# AUTOMATION_EMAILS_PER_RECIPIENT_DAY=5
# Trust X-Forwarded-For for client addresses ("true" or "1"). Only behind a reverse proxy you control. Default false.
# TRUST_PROXY=false
# Comma-separated browser origins allowed to call the MCP HTTP server (e.g. https://app.example.com). Default: none.
# MCP_ALLOWED_ORIGINS=
# Development only: also create the hlcrm_test database on first init (needed to run the test suite). Default: off.
# HLCRM_CREATE_TEST_DB=true
# Log level: trace, debug, info, warn, error, fatal or silent. Default info. Docker Compose sets this in docker-compose.yml, not from this file.
# LOG_LEVEL=info
# Directory for write-once audit anchors (local disk). Default ./data/blobs. Compose sets /data/blobs on the `blobs` volume; back that volume up.
# BLOB_DIR=./data/blobs
# Files attached to records (docs/data-model.md, "Files and notes"). Bytes are kept in Postgres unless FILE_STORE=s3.
# FILE_STORE=postgres
# The largest file one upload may hold, and what one workspace's files may hold in all, in MB. Defaults 10 and 1024.
# FILE_MAX_MB=10
# FILE_QUOTA_MB=1024
# Days between an owner asking for their workspace to be deleted and the worker deleting it; they can withdraw it meanwhile
# (docs/data-model.md, "Deleting a workspace"). Default 7. 0 deletes on the worker's next pass.
# WORKSPACE_DELETION_GRACE_DAYS=7
# With FILE_STORE=s3: an S3-compatible store (AWS S3, MinIO, Cloudflare R2, Backblaze B2). Files there are sealed with the
# workspace's data key, so back the bucket up together with the database and HLCRM_MASTER_KEY.
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_BUCKET=crm-files
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# People sign-in (docs/sign-in.md). Off until PUBLIC_URL is set: the origin people use, no path.
# https only, except http://localhost for local development.
# PUBLIC_URL=https://crm.example.com
# The web UI (packages/web) is served by the API at PUBLIC_URL when its built files are present (they are in the
# Docker image). Set to false for an API-only deployment. WEB_UI_DIR points at another build of it.
# WEB_UI=true
# WEB_UI_DIR=
# Sign out after this many idle minutes (default 720 = 12 hours) and after this many hours at most (default 168 = 7 days).
# SESSION_IDLE_TIMEOUT_MINUTES=720
# SESSION_ABSOLUTE_TIMEOUT_HOURS=168
# Set but invalid (a path, plain http on another host), the server refuses to start; leave it unset to keep people sign-in off.
# Member emails must be printable ASCII (internationalized addresses aren't supported yet).
# Allow password sign-in at all (default true). A workspace owner can also turn it off for their workspace.
# PASSWORD_SIGN_IN=true
# How hard to guess a new password must be, as the built-in estimate (zxcvbn) rates it: 0 to 4. Default 3.
# 4 also refuses a word with a year and punctuation ("Summer2026!!!") and short phrases. 0 turns the estimate
# off (length and the email and workspace-name rules still apply). Below 3 is weaker than recommended.
# PASSWORD_MIN_STRENGTH=3
# Check new passwords against Have I Been Pwned; only 5 hex characters of a SHA-1 leave the server. Default false.
# PASSWORD_BREACH_CHECK=false
# Single sign-on through one OpenID Connect provider. Redirect URI to register: <PUBLIC_URL>/auth/sso/callback
# SSO trusts the provider to verify email addresses. It is on for every workspace by default; each workspace's
# owner can turn it off or narrow its email domains (PATCH /v1/workspace/sign-in).
# OIDC_ISSUER=https://accounts.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Label on the sign-in button ("Sign in with …"). Default: single sign-on.
# OIDC_DISPLAY_NAME=Okta
# Comma-separated email domains allowed through single sign-on, checked on every SSO sign-in. Default: any verified email of an existing member.
# OIDC_ALLOWED_DOMAINS=example.com
# Allow an identity provider on http:// or a private address (an internal provider). Metadata IPs stay blocked. Default false.
# OIDC_ALLOW_INSECURE_ISSUER=false
# OAuth for the remote MCP servers (docs/mcp/oauth.md), so Claude, ChatGPT or Cursor can connect by
# signing in and approving. Off until MCP_PUBLIC_URL is set: the origin MCP clients reach the MCP server
# at (it may equal PUBLIC_URL behind one reverse proxy). Needs PUBLIC_URL and MCP_SERVICE_SECRET.
# Set but invalid or missing what it needs, the API and MCP processes refuse to start.
# MCP_PUBLIC_URL=https://mcp.example.com
# A random value, the same for the api and mcp services (init-env.sh makes one, or `openssl rand -hex 32`):
# at least 32 characters with at least 16 different ones (or 64 hex digits). A weak value stops both processes.
# The MCP process sends it with every call it makes for an OAuth token; without it the API refuses such tokens.
# MCP_SERVICE_SECRET=
# Access token life in minutes (default 60), refresh token life when unused in days (default 30),
# and the longest a connection lasts before the member approves it again, in days (default 180).
# OAUTH_ACCESS_TOKEN_MINUTES=60
# OAUTH_REFRESH_TOKEN_DAYS=30
# OAUTH_GRANT_MAX_DAYS=180
